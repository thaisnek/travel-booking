PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
PAYPAL_MODE=sandbox

DB_URL=jdbc:mysql://localhost:3306/travel
DB_USERNAME=your-db-user
DB_PASSWORD=your-db-password
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false

MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-mail-app-password

AVATAR_UPLOAD_DIR=C:/tmp/travelweb/avatar
TOUR_UPLOAD_DIR=C:/tmp/travelweb/tour

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080/ltweb
FLASK_API_URL=http://127.0.0.1:5555

JWT_SECRET=replace-with-at-least-64-random-characters-for-hs512-signing
JWT_EXPIRATION=86400000
